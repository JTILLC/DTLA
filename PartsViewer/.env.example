# Firebase Configuration
# Copy this file to .env and fill in your Firebase credentials
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Cloud Vision API
# For OCR auto-detection of part numbers on diagrams
# Can use the same key as Firebase if they're in the same Google Cloud project
# VITE_GOOGLE_VISION_API_KEY — REMOVED 2026-08-26.
# Vite inlines VITE_* into the bundle, so this key was readable in the
# deployed JavaScript without signing in. Vision is now called through
# the ccw-media Worker (/vision-ocr); the key is a Worker secret named
# GOOGLE_VISION_API_KEY. Do not reintroduce it here.
