{
  "rules": {
    "jti-downtime": {
      ".read": "auth != null",
      ".write": "auth != null",

      "shares": {
        "$token": {
          ".read": true
        }
      }
    },

    "shared-views": {
      "$token": {
        ".read": true,
        ".write": "auth != null"
      }
    }
  }
}
