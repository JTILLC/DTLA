# Local Netlify folder
.netlify

# Dated snapshots of past app states, kept out of the way in one place rather
# than as fifty directories in the root. NOT tracked by git and never were —
# these are the only copies, so they are ignored, not deleted.
_archive/

# ---------------------------------------------------------------------------
# Generated files. Untracked 2026-08-14, when 216,462 node_modules files and
# 119 build outputs made up the bulk of this repo — `git status` was unreadable
# and every clone carried dependencies that `npm install` rebuilds from the
# lockfiles, which ARE tracked.
#
# This does not shrink history: past commits keep their copies. It stops the
# working tree lying about what is source.
node_modules/

# Build output, per app rather than a blanket `dist/`.
#
# JobsMASTER/dist is deliberately absent from this list: despite the name it
# holds hand-written HTML (index.html, Jobs101525.html) and no build step makes
# it. Ignoring it would quietly drop the only tracked copy of the Jobs app.
CCWCustomerViewer/dist/
CCWISSUESGitHub/dist/
CCWISSUESMultiTenant/dist/
JTIUnified/dist/
ServiceQuoteWA/dist/
ShearersClaude/dist/
JTIWebsite/dist/

# Deploy caches and dated snapshots, same reasoning as _archive/ above: these
# are produced by a tool or are a copy of a past state, and neither belongs in
# history. JobsMASTER/backups holds one dated snapshot of the Jobs app.
JobsMASTER/.firebase/
JobsMASTER/backups/

# Service-account keys. These grant full access to a Firebase project and are
# the one kind of file that must never reach a remote — a key committed once is
# in the history for good, whatever happens to the file afterwards. They belong
# in `wrangler secret put`, not here.
*-firebase-adminsdk-*.json
*serviceAccount*.json
*service-account*.json

# jti-timesheet is its OWN git repository (github.com/JTILLC/jti-timesheet)
# living inside this one. Adding it here records a gitlink, not the files: a
# clone of DTLA would get an empty directory and no way to fill it. Ignored so
# `git add -A` cannot do that by accident. Commit its changes from inside it.
jti-timesheet/
