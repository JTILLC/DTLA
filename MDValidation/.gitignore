# Build output and dependencies — regenerated by npm install and npm run
# build, from the lockfile and source that ARE tracked. Committing them is what
# left this repo with 60,000 tracked files for one app.
node_modules
dist
dist-ssr
*.local

# Secrets. VITE_ variables end up in the client bundle, so a genuinely secret
# key does not belong in one at all — but a key committed once is in the
# history for good, whatever happens to the file afterwards.
.env
.env.*
!.env.example

# Deploy and editor state, local to this machine
.netlify
.wrangler
.firebase
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
