rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ---- Reads --------------------------------------------------------------
    //
    // CCW media (issue-photos/**, service-reports/**) is NO LONGER publicly
    // readable. It is served exclusively by the media broker Worker, which
    // authenticates with a service account — service accounts use IAM and are
    // not subject to these rules, so the broker keeps working. Every request it
    // serves is re-checked against a live share link or the caller's claims, so
    // media access finally expires with the share.
    //
    // Everything else stays public. This bucket is shared with other JTI apps
    // (e.g. JTI Inventory under user_files/**/inventory-photos/), which read
    // their images by public URL; denying those would break them.
    //
    // Why the exclusion lives in the CONDITION rather than a narrower match:
    // Firebase rules are ADDITIVE. A broad `allow read: if true` cannot be
    // overridden by a more specific `allow read: if false` — if any matching
    // rule grants access, access is granted. So the catch-all itself has to
    // exclude the CCW prefixes.
    //
    // The `.*prefix/.*` form matches whether or not resource.name carries a
    // bucket prefix. That bias is deliberate: an over-broad match denies a read
    // (which the broker still serves), while an under-broad one would silently
    // leave customer photos public.
    match /{allPaths=**} {
      allow read: if resource == null || !isBrokerOnly();
    }

    function isBrokerOnly() {
      return resource.name.matches('.*issue-photos/.*')
          || resource.name.matches('.*service-reports/.*')
          || resource.name.matches('.*pm-images/.*');
    }

    // ---- Writes: ownership enforced via CUSTOM CLAIMS -----------------------
    //
    // Previously any authenticated user could write or delete ANY path, so one
    // tenant's login could clobber another tenant's photos. Storage rules can't
    // read the app_roles collection, so ownership rides on the auth token
    // instead: scripts/sync-claims.mjs mirrors app_roles -> custom claims
    // (`admin`, `customerId`). Both upload paths embed the customer id, so the
    // rule compares the path segment against the caller's claim.
    //
    // NOTE: a user's claims only take effect once their ID token refreshes
    // (about an hour, or immediately on re-login / getIdToken(true)).

    // issue-photos/{workspaceId}/{customerId}/{visitId}/{lineId}/head-{n}/{file}
    match /issue-photos/{workspaceId}/{customerId}/{rest=**} {
      allow write: if canWrite(customerId)
        && (request.resource == null
            || (request.resource.size < 15 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // service-reports/{workspaceId}/{customerId}/{visitId}.pdf
    match /service-reports/{workspaceId}/{customerId}/{rest=**} {
      allow write: if canWrite(customerId)
        && (request.resource == null
            || (request.resource.size < 25 * 1024 * 1024
                && request.resource.contentType == 'application/pdf'));
    }

    // pm-images/{workspaceId}/{customerId}/{itemId}.jpg
    // Reference photos on the PM checklist — "this is what to look at". Written
    // by whoever maintains the checklist, read by operators through the broker
    // like all other CCW media, rather than carving out a public exception for
    // pictures of a customer's equipment.
    match /pm-images/{workspaceId}/{customerId}/{rest=**} {
      allow write: if canWrite(customerId)
        && (request.resource == null
            || (request.resource.size < 15 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }

    // No write rule for any other path → arbitrary uploads are denied.

    // --- helpers ---
    // An admin (JTI staff) may write anywhere. A customer login may only write
    // under its own customer id. Users with no claims yet can't write at all —
    // run the claims sync before relying on this.
    function canWrite(customerId) {
      return request.auth != null
        && (request.auth.token.get('admin', false) == true
            || request.auth.token.get('customerId', '') == customerId);
    }
  }
}
