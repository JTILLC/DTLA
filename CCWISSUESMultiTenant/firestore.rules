rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared backend-wide (one Firebase project serves the original app, this
    // fork, AND the login-less customer viewer). READ ISOLATION is enforced here:
    // a customer's data is readable only by an admin, that customer's own login,
    // or the viewer when the customer has an active public share.

    // Multi-tenant roles. Reads: a user's own role doc (or admin). Writes: admin.
    match /app_roles/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Markers: which customers have an active public share. Written by ShareModal
    // (admin) on share / cleared on revoke-of-last. The read rule below uses
    // exists() on these (server-side; no client read needed).
    match /shared_customers/{cid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Per-customer supervisor-password hash — kept OUT of the public profile so a
    // share-link holder (isSharedCustomer) can never read it. Only admin and that
    // customer's own login may read; only admin sets it.
    match /customer_secrets/{cid} {
      allow read: if isAdmin() || isCustomerOf(cid);
      allow write: if isAdmin();
    }

    // Reusable signature library — each doc is owner-scoped by ownerId, enforced here.
    match /user_signatures/{sigId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // Customer viewer share links. A specific token is public-read (the login-less
    // viewer resolves it) UNTIL IT EXPIRES; LISTING is admin-only so tokens/
    // customers can't be enumerated. Writes: admin.
    //
    // `expiresAt == null` means "never expires" — links created before expiry
    // existed are grandfathered and keep working until explicitly revoked.
    match /shared_visits/{token} {
      allow get: if notExpired(resource.data.get('expiresAt', null));
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Workspace data. READ: admin, the owning customer's login, or — for the
    // login-less viewer — when that customer has an active public share.
    // WRITE: admin, or the owning customer within the known workspace.
    match /user_files/{workspaceId} {
      allow read: if isAdmin();
      allow write: if isAdmin();

      match /customers/{cid}/{document=**} {
        allow read: if isAdmin() || isCustomerOf(cid) || isSharedCustomer(cid);
        allow write: if isAdmin()
          || (workspaceId == 'tgezUokMZ1PO7iEDbLbj2U7Uwbx1' && isCustomerOf(cid));
      }
    }

    // Anything else: admins only.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- helpers ---
    function roleData() {
      return get(/databases/$(database)/documents/app_roles/$(request.auth.uid)).data;
    }
    function hasRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/app_roles/$(request.auth.uid));
    }
    function isAdmin() {
      return hasRole() && roleData().admin == true;
    }
    function isCustomerOf(cid) {
      return hasRole() && roleData().customerId == cid;
    }
    // A customer is publicly readable only while its share marker exists AND has
    // not expired. ShareModal keeps the marker's expiresAt at the LATEST expiry
    // among that customer's live links, and deletes the marker when none remain,
    // so public read closes on its own instead of staying open forever.
    function isSharedCustomer(cid) {
      return exists(/databases/$(database)/documents/shared_customers/$(cid))
        && notExpired(
             get(/databases/$(database)/documents/shared_customers/$(cid)).data.get('expiresAt', null)
           );
    }

    // Null expiry == never expires (grandfathered links).
    function notExpired(expiresAt) {
      return expiresAt == null || request.time < expiresAt;
    }
  }
}
