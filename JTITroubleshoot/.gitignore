# Build output and dependencies — regenerated by npm install and npm run
# build, from the lockfile and source that ARE tracked. Committing them is what
# left this repo with 60,000 tracked files for one app.
node_modules
dist
dist-ssr
*.local

# Secrets. VITE_ variables end up in the client bundle, so a genuinely secret
# key does not belong in one at all — but a key committed once is in the
# history for good, whatever happens to the file afterwards.
.env
.env.*
!.env.example

# Deploy and editor state, local to this machine
.netlify
.wrangler
.firebase
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea

# Mined correspondence — NOT for git.
#
# emails.json holds 157 distinct email addresses lifted from an Outlook .pst,
# and serviceLog.json is the matching service history. That is other people's
# correspondence: it is fine on this machine, and it is not something to push to
# a hosting provider, where it would sit in the history permanently and be
# readable by anyone who is ever given access to the repo.
#
# The app is tracked WITHOUT its data. To run it, regenerate these with the
# parser (which lives outside this repo) against the .pst.
src/emails.json
src/serviceLog.json
